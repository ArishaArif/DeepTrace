# Generated data / large artifacts — reproducible, never commit
sample/
data/
cache/
tmp_recompressed/
*.zip

# Python bytecode / caches
__pycache__/
.pytest_cache/
*.pyc

# Frozen model artifacts ARE deliverables for the Deep/Backend branches,
# so re-include them even though ml/.gitignore excludes *.joblib repo-wide.
!model/*.joblib
!model/v1/*.joblib
!model/v2/*.joblib
